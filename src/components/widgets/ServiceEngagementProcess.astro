---
import Button from "../../layouts/components/Button.astro";
/**
 * Service page — Defined Engagement Process (KEY_SERVICE_PAGE_COMPONENTS §3).
 * Generic and scalable: all content arrives via props from the service's
 * verified source of truth. Nothing service-specific is hardcoded.
 *
 * Four required content elements:
 *  - phases:       ordered phases of the engagement, each with what happens
 *  - clientInputs: inputs required from the client (short asks — flat strings)
 *  - outputs:      deliverables produced by the service provider
 *  - timing:       decision points / dependencies — only when verified
 *
 * Outputs are structured (`label` + optional `description`), not flat strings:
 * each deliverable is a distinct sub-offer with SEO weight of its own (see
 * `Service.offers` in src/lib/seo/service.ts — the site's existing, native
 * mechanism for representing sub-offers as structured data; wiring an output
 * to that schema is a later phase, not this component). A flat string can't
 * carry a heading, can't be individually addressed, and can't grow into its
 * own page later without a rewrite — this shape can. Each rendered deliverable
 * also gets a stable id (`${id}-output-${slug}`) so it is independently
 * anchor-linkable now, even though nothing links to it yet.
 *
 * ROW POSITIONS ARE FIXED AND IDENTICAL IN ALL VARIANTS — never moved:
 *   Row 1: phases rail (7 cols) + empty timing column (5 cols)
 *   Row 2: "What we need from you" checklist, full-width
 *   Row 3: "What you get" deliverable cards
 * All three variants are clones of this structure. They differ ONLY in
 * internal density (how many columns each row's list wraps into). No row
 * changes position in any variant.
 *
 * Density options:
 *  1 (base)    — phases rail as-is; needs checklist single-column; outputs
 *                4-col bordered cards under their own divider
 *  2 (compact) — needs checklist items split into a 2-column grid (halves
 *                row 2's height); outputs unchanged from base
 *  3 (dense)   — same as 2, plus outputs drop their divider band and render
 *                as a borderless 4-col card row directly after row 2
 */
export type ServiceProcessPhase = {
  name: string;
  description: string;
};
export type ServiceProcessDeliverable = {
  label: string;
  description?: string;
};
export type ServiceProcessContent = {
  intro?: string;
  processTitle: string;
  phases: ServiceProcessPhase[];
  clientInputs?: string[];
  outputs?: ServiceProcessDeliverable[];
  timing?: string;
  cta?: { label: string; href: string };
};
interface Props {
  id: string;
  content: ServiceProcessContent;
  variant: "base" | "compactNeeds" | "dense";
  headingLevel?: "h2" | "h3";
}
const { id, content: c, variant, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const colHead = "font-secondary text-primary text-h6-sm mb-4 font-bold tracking-wider uppercase";
const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
const outputId = (label: string, index: number) => `${id}-output-${slugify(label) || index}`;
const hasNeeds = Boolean(c.clientInputs && c.clientInputs.length > 0);
const hasOutputs = Boolean(c.outputs && c.outputs.length > 0);
const clientInputs = c.clientInputs || [];
const outputs = c.outputs || [];
---

<section id={id} aria-labelledby={`${id}-title`} class="pt-0!">
  {
    variant === "base" ? (
      <div class="bg-body">
        <div class="container py-14 lg:py-20">
          <Heading
            id={`${id}-title`}
            class="text-h3-sm md:text-h3 text-dark max-w-3xl"
            data-aos="reveal-anim-top"
            data-aos-offset="0"
            data-aos-duration="600">
            {c.processTitle}
          </Heading>
          {c.intro && (
            <p class="text-text-dark/85 mt-4 max-w-3xl text-base leading-relaxed lg:text-lg">{c.intro}</p>
          )}
          <div class="border-border-dark/20 mt-8 grid grid-cols-1 gap-10 border-t pt-10 lg:grid-cols-12 lg:gap-14">
            <div class="lg:col-span-7">
              <h3 class={colHead}>The phases</h3>
              <ol class="border-border-dark border-s">
                {c.phases.map((phase) => (
                  <li class="relative ps-8 pb-8 last:pb-0">
                    <span class="bg-accent absolute inset-s-[-9px] top-1 flex h-4 w-4 items-center justify-center rounded-full" aria-hidden="true" />
                    <h4 class="text-dark text-base font-bold">{phase.name}</h4>
                    <p class="text-text-dark/85 mt-1 text-base leading-relaxed">{phase.description}</p>
                  </li>
                ))}
              </ol>
              {c.timing && (
                <p class="text-text-dark/85 mt-8 text-base leading-relaxed lg:text-lg">{c.timing}</p>
              )}
            </div>
            <div class="lg:col-span-5" />
          </div>
          {hasNeeds && (
            <div class="border-border-dark/20 mt-10 border-t pt-10">
              <h3 class={colHead}>What we need from you</h3>
              <div class="has-list has-list-check styled-list">
                <ul>
                  {clientInputs.map((input) => (
                    <li>{input}</li>
                  ))}
                </ul>
              </div>
            </div>
          )}
          {hasOutputs && (
            <div class="border-border-dark/20 mt-10 border-t pt-10">
              <h3 class={colHead}>What you get</h3>
              <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {outputs.map((output, index) => (
                  <div id={outputId(output.label, index)} class="bg-light border-border-dark/20 border p-4 md:p-6 lg:p-5 xl:p-6">
                    <h4 class="text-h6-sm lg:text-h6 xl:text-h5">{output.label}</h4>
                    {output.description && (
                      <p class="text-text-dark/85 mt-2 text-base leading-relaxed">{output.description}</p>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}
          {c.cta && (
            <div class="mt-8">
              <Button label={c.cta.label} url={c.cta.href} variant="fill" class="whitespace-normal min-w-0" />
            </div>
          )}
        </div>
      </div>
    ) : variant === "compactNeeds" ? (
      <div class="bg-body">
        <div class="container py-14 lg:py-20">
          <Heading
            id={`${id}-title`}
            class="text-h3-sm md:text-h3 text-dark max-w-3xl"
            data-aos="reveal-anim-top"
            data-aos-offset="0"
            data-aos-duration="600">
            {c.processTitle}
          </Heading>
          {c.intro && (
            <p class="text-text-dark/85 mt-4 max-w-3xl text-base leading-relaxed lg:text-lg">{c.intro}</p>
          )}
          <div class="border-border-dark/20 mt-8 grid grid-cols-1 gap-10 border-t pt-10 lg:grid-cols-12 lg:gap-14">
            <div class="lg:col-span-7">
              <h3 class={colHead}>The phases</h3>
              <ol class="border-border-dark border-s">
                {c.phases.map((phase) => (
                  <li class="relative ps-8 pb-8 last:pb-0">
                    <span class="bg-accent absolute inset-s-[-9px] top-1 flex h-4 w-4 items-center justify-center rounded-full" aria-hidden="true" />
                    <h4 class="text-dark text-base font-bold">{phase.name}</h4>
                    <p class="text-text-dark/85 mt-1 text-base leading-relaxed">{phase.description}</p>
                  </li>
                ))}
              </ol>
              {c.timing && (
                <p class="text-text-dark/85 mt-8 text-base leading-relaxed lg:text-lg">{c.timing}</p>
              )}
            </div>
            <div class="lg:col-span-5" />
          </div>
          {hasNeeds && (
            <div class="border-border-dark/20 mt-10 border-t pt-10">
              <h3 class={colHead}>What we need from you</h3>
              <ul class="grid grid-cols-1 gap-x-10 gap-y-2 sm:grid-cols-2">
                {clientInputs.map((input) => (
                  <li class="text-text-dark/85 text-base leading-relaxed">{input}</li>
                ))}
              </ul>
            </div>
          )}
          {hasOutputs && (
            <div class="border-border-dark/20 mt-10 border-t pt-10">
              <h3 class={colHead}>What you get</h3>
              <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {outputs.map((output, index) => (
                  <div id={outputId(output.label, index)} class="bg-light border-border-dark/20 border p-4 md:p-6 lg:p-5 xl:p-6">
                    <h4 class="text-h6-sm lg:text-h6 xl:text-h5">{output.label}</h4>
                    {output.description && (
                      <p class="text-text-dark/85 mt-2 text-base leading-relaxed">{output.description}</p>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    ) : (
      <div class="bg-body">
        <div class="container py-14 lg:py-20">
          <Heading
            id={`${id}-title`}
            class="text-h3-sm md:text-h3 text-dark max-w-3xl"
            data-aos="reveal-anim-top"
            data-aos-offset="0"
            data-aos-duration="600">
            {c.processTitle}
          </Heading>
          {c.intro && (
            <p class="text-text-dark/85 mt-4 max-w-3xl text-base leading-relaxed lg:text-lg">{c.intro}</p>
          )}
          <div class="border-border-dark/20 mt-8 grid grid-cols-1 gap-10 border-t pt-10 lg:grid-cols-12 lg:gap-14">
            <div class="lg:col-span-7">
              <h3 class={colHead}>The phases</h3>
              <ol class="border-border-dark border-s">
                {c.phases.map((phase) => (
                  <li class="relative ps-8 pb-8 last:pb-0">
                    <span class="bg-accent absolute inset-s-[-9px] top-1 flex h-4 w-4 items-center justify-center rounded-full" aria-hidden="true" />
                    <h4 class="text-dark text-base font-bold">{phase.name}</h4>
                    <p class="text-text-dark/85 mt-1 text-base leading-relaxed">{phase.description}</p>
                  </li>
                ))}
              </ol>
              {c.timing && (
                <p class="text-text-dark/85 mt-8 text-base leading-relaxed lg:text-lg">{c.timing}</p>
              )}
            </div>
            <div class="lg:col-span-5" />
          </div>
          {hasNeeds && (
            <div class="border-border-dark/20 mt-10 border-t pt-10">
              <h3 class={colHead}>What we need from you</h3>
              <ul class="divide-border-dark divide-y">
                {clientInputs.map((input) => (
                  <li class="text-text-dark/85 py-3 text-base leading-relaxed">{input}</li>
                ))}
              </ul>
            </div>
          )}
          {hasOutputs && (
            <div class="border-border-dark/20 mt-10 border-t pt-10">
              <h3 class={colHead}>What you get</h3>
              <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {outputs.map((output, index) => (
                  <div id={outputId(output.label, index)} class="bg-light border-border-dark/20 border p-4 md:p-6 lg:p-5 xl:p-6">
                    <h4 class="text-h6-sm lg:text-h6 xl:text-h5">{output.label}</h4>
                    {output.description && (
                      <p class="text-text-dark/85 mt-2 text-base leading-relaxed">{output.description}</p>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    )
  }
</section>