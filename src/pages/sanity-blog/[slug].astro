---
import Base from "@/layouts/Base.astro";
import CTASection from "@/components/sections/CTASection.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import SanityBlogSidebar from "@/layouts/components/widgets/SanityBlogSidebar.astro";
import SanityPortableTextContent from "@/layouts/components/widgets/SanityPortableTextContent.astro";
import {
  getSanityBlogPost,
  getSanityBlogPosts,
  sanityImageUrl,
  type SanityBlogPost,
} from "@/lib/sanity/client";

export async function getStaticPaths() {
  const posts = await getSanityBlogPosts();

  return Promise.all(
    posts.map(async (post) => ({
      params: { slug: post.slug.current },
      props: {
        post: (await getSanityBlogPost(post.slug.current)) || post,
        posts,
      },
    })),
  );
}

const { post: staticPost, posts: staticPosts } = Astro.props as {
  post?: SanityBlogPost;
  posts?: SanityBlogPost[];
};
const slug = Astro.params.slug;
const post = staticPost || (await getSanityBlogPost(slug));
const posts = staticPosts || (await getSanityBlogPosts());

if (!post) {
  return Astro.redirect("/404");
}

const coverImage = post.coverImage?.asset
  ? sanityImageUrl(post.coverImage.asset).width(896).height(500).fit("crop").auto("format").url()
  : undefined;
const publishedDate = new Date(post.publishedAt);
---

<Base
  title={post.title}
  metaTitle={post.title}
  metaDescription={post.excerpt}
  image={coverImage}
>
  <PageHeader
    content={{
      badge: post.categories?.[0],
      title: post.title,
      postData: {
        date: publishedDate,
        author: "Good Shepherd Insights",
      },
    }}
    contentClass=""
  />

  <main class="container py-16 lg:py-24">
    <div class="grid grid-cols-1 items-start gap-x-8 gap-y-16 lg:grid-cols-12">
      <article class="blog-details space-y-10 lg:col-span-8">
        {
          coverImage && (
            <img
              src={coverImage}
              alt={post.coverImage?.alt || post.title}
              width="896"
              height="500"
              loading="eager"
              decoding="sync"
              class="h-auto w-full rounded-xl object-cover"
            />
          )
        }

        <SanityPortableTextContent
          value={post.body || []}
          class="pt-10"
          faqMode="shadow"
        />

        {
          post.tags?.length ? (
            <div class="border-border-dark/20 flex w-full flex-wrap gap-3 border-y py-4 lg:py-8">
              {post.tags.map((tag) => <span class="bg-light rounded-md px-4 py-1.5 text-sm capitalize">{tag}</span>)}
            </div>
          ) : null
        }
      </article>

      <SanityBlogSidebar posts={posts} currentSlug={post.slug.current} />

    </div>
  </main>

  <CTASection hasNoLightBackground={true} />
</Base>
