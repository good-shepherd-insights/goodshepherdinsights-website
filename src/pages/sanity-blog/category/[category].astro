---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import SanityBlogSidebar from "@/layouts/components/widgets/SanityBlogSidebar.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { getSanityBlogPosts, sanityImageUrl, type SanityBlogPost } from "@/lib/sanity/client";
import { slugifyyy } from "@/lib/utils/textConverter";
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import dateFormat from "@/lib/utils/dateFormat";

export async function getStaticPaths() {
  const posts = await getSanityBlogPosts();
  const categories = new Map<string, string>();

  for (const post of posts) {
    for (const category of post.categories || []) {
      categories.set(slugifyyy(category), category);
    }
  }

  return [...categories.entries()].map(([category, categoryName]) => ({
    params: { category },
    props: { posts, categoryName },
  }));
}

const { posts, categoryName } = Astro.props as {
  posts: SanityBlogPost[];
  categoryName: string;
};
const categorySlug = Astro.params.category || "";
const categoryPosts = posts.filter((post) =>
  post.categories?.some((category) => slugifyyy(category) === categorySlug),
);
const postUrl = (slug: string) => getLocaleUrlCTM(slug, Astro.currentLocale, "/blog");
---

<Base
  title={`${categoryName} posts`}
  metaTitle={`${categoryName} posts`}
  metaDescription={`Recent Good Shepherd Insights posts about ${categoryName}.`}
  robots="noindex, follow"
>
  <PageHeader content={{ title: `${categoryName} posts` }} contentClass="max-w-3xl! xl:px-6" />

  <main class="container py-16 lg:py-24">
    <div class="grid grid-cols-1 items-start gap-x-8 gap-y-16 lg:grid-cols-12">
      <section class="space-y-8 lg:col-span-8" aria-labelledby="category-posts-heading">
        <h2 id="category-posts-heading" class="sr-only">{categoryName} posts</h2>
        {
          categoryPosts.map((post) => {
            const image = post.coverImage?.asset
              ? sanityImageUrl(post.coverImage.asset).width(640).height(360).fit("crop").auto("format").url()
              : undefined;

            return (
              <article class="border-border-dark/15 group relative grid gap-6 border-b pb-8 md:grid-cols-5">
                {image && (
                  <img
                    src={image}
                    alt={post.coverImage?.alt || post.title}
                    width="320"
                    height="180"
                    loading="lazy"
                    class="h-44 w-full rounded-lg object-cover md:col-span-2"
                  />
                )}
                <div class:list={["space-y-3", image ? "md:col-span-3" : "md:col-span-5"]}>
                  <p class="text-text-dark/60 text-sm">{dateFormat(post.publishedAt)}</p>
                  <h3 class="text-h5-sm lg:text-h5 group-hover:text-accent transition-colors">
                    {post.title}
                  </h3>
                  {post.excerpt && <p class="text-text-dark/80 leading-6">{post.excerpt}</p>}
                  <a
                    href={postUrl(post.slug.current)}
                    class="text-primary inline-block font-semibold"
                    aria-label={`Read ${post.title}`}
                  >
                    Read post
                  </a>
                </div>
              </article>
            );
          })
        }
      </section>

      <SanityBlogSidebar posts={posts} currentSlug="" />
    </div>
  </main>

  <CTASection hasNoLightBackground={true} />
</Base>
