---
import Base from "@/layouts/Base.astro";
import handleDraftPage from "@/lib/utils/handleDraftPage";
import PageHeader from "@/components/widgets/PageHeader.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import StatsMarqueeSection from "@/components/sections/StatsMarqueeSection.astro";
import FaqSectionTwo from "@/components/sections/FaqSectionTwo.astro";
import CTAGallerySection from "@/components/sections/CTAGallerySection.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { Schema } from "astro-seo-schema";
import type { FAQPage } from "schema-dts";
import { absoluteUrl } from "@/lib/utils/absoluteUrl";
import { getSanityFaqPage } from "@/lib/sanity/pages";

export function getStaticPaths() {
  return generatePaths();
}

const entry = await getSanityFaqPage();
if (!entry) return Astro.redirect("/404");

// Remove drafts pages in production
const response = handleDraftPage(entry);
if (response) return response;

// Resolve canonical for this FAQ page
const resolvedCanonical = absoluteUrl(Astro.url.pathname, Astro);

// Build FAQPage schema from faqSection data
const faqList = (entry as any)?.faqSection?.list
  ?.filter((item: any) => item.enable !== false)
  ?.map((item: any) => ({
    "@type": "Question",
    name: item.title,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.content,
    },
  })) || [];

// Fallback: use the Sanity secondary FAQ section if the primary page section has no items.
let faqItems = faqList;
if (faqItems.length === 0) {
  faqItems = (entry as any)?.faqSectionTwo?.list
    ?.filter((item: any) => item.enable !== false)
    ?.map((item: any) => ({
      "@type": "Question",
      name: item.title,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.content,
      },
    })) || [];
}

let faqSchema: FAQPage | undefined;
if (faqItems.length > 0) {
  faqSchema = {
    "@type": "FAQPage",
    "@id": `${resolvedCanonical}#faqpage`,
    mainEntity: faqItems,
  };
}
---

<Base {...entry}>
  <PageHeader content={entry} />
  <FaqSection content={(entry as any)?.faqSection} mode="light" />
  <StatsMarqueeSection content={(entry as any)?.statsMarqueeSection} hasLightBackground={true} />
  <FaqSectionTwo content={(entry as any)?.faqSectionTwo} mode="shadow" />
  <CTAGallerySection content={(entry as any)?.ctaGallerySection} />
  <CTASection />

  <!-- Page-specific structured data -->
  {faqSchema && <Schema item={{ "@context": "https://schema.org", ...faqSchema } as any} />}
</Base>
