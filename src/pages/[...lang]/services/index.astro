---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import PageHeader from "@/components/widgets/PageHeader.astro";
import ServicesListSection from "@/components/sections/ServicesListSection.astro";
import FeaturesGridThree from "@/components/sections/FeaturesGridThree.astro";
import StatsMarqueeSection from "@/components/sections/StatsMarqueeSection.astro";
import ProcessSectionTwo from "@/components/sections/ProcessSectionTwo.astro";
import CTAVideoSectionTwo from "@/components/sections/CTAVideoSectionTwo.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { Schema } from "astro-seo-schema";
import { absoluteUrl } from "@/lib/utils/absoluteUrl";
import {
  getSanityServices,
  getSanityServicesIndex,
  serviceImageUrl,
  serviceUrl,
} from "@/lib/sanity/services";
import { buildSchemaIds } from "@/lib/seo/ids";
import { buildItemListSchema } from "@/lib/seo/itemList";
import { schemaGraph } from "@/lib/seo/types";
import { buildCollectionPageSchema } from "@/lib/seo/webpage";

export function getStaticPaths() {
  return generatePaths();
}

const selfCanonical = absoluteUrl(Astro.url.pathname, Astro);
const servicesIndex = await getSanityServicesIndex();
const services = await getSanityServices();

if (!servicesIndex) {
  throw new Error("Missing Sanity serviceIndex document.");
}

const resolvedCanonical = servicesIndex.seo?.canonical
  ? absoluteUrl(servicesIndex.seo.canonical, Astro)
  : selfCanonical;
const schemaIds = buildSchemaIds(resolvedCanonical, Astro.url.href);
const collectionPageSchema = schemaGraph([
  buildCollectionPageSchema({
    ids: schemaIds,
    name: servicesIndex.seo?.metaTitle || servicesIndex.title,
    description: servicesIndex.seo?.metaDescription || servicesIndex.excerpt,
  }),
  buildItemListSchema({
    id: schemaIds.itemList,
    itemType: "Service",
    baseUrl: schemaIds.baseUrl,
    items: services.map((service) => ({
      name: service.title,
      url: serviceUrl(service, Astro.currentLocale),
      description: service.seo?.metaDescription || service.excerpt,
      image: serviceImageUrl(service, 1200, 630),
    })),
  }),
]);
---

<Base
  title={servicesIndex.title}
  metaTitle={servicesIndex.seo?.metaTitle || servicesIndex.title}
  metaDescription={servicesIndex.seo?.metaDescription || servicesIndex.excerpt}
  canonical={resolvedCanonical}
  robots={servicesIndex.seo?.robots}
  keywords={servicesIndex.seo?.keywords}
  image={servicesIndex.image}
  imageAlt={servicesIndex.imageAlt}
  hideOffcanvas={true}
  schemaMainEntityId={schemaIds.itemList}>
  <PageHeader
    content={{
      badge: servicesIndex.badge,
      title: servicesIndex.title,
      image: servicesIndex.image,
      imageAlt: servicesIndex.imageAlt,
    }}
  />
  <ServicesListSection
    content={servicesIndex.servicesList}
    hasPaddingBottom={true}
  />
  {
    servicesIndex.featureGrid && (
      <FeaturesGridThree content={servicesIndex.featureGrid} />
    )
  }
  {
    servicesIndex.statsMarquee && (
      <StatsMarqueeSection
        content={servicesIndex.statsMarquee}
        hasLightBackground={false}
      />
    )
  }
  {
    servicesIndex.processSection && (
      <ProcessSectionTwo
        content={servicesIndex.processSection}
        hasPaddingBottom={true}
      />
    )
  }
  {
    servicesIndex.ctaVideoSection && (
      <CTAVideoSectionTwo
        content={servicesIndex.ctaVideoSection}
        hasLightBackground={false}
      />
    )
  }
  {
    servicesIndex.ctaSection && (
      <CTASection content={servicesIndex.ctaSection} />
    )
  }
  <Schema item={collectionPageSchema as any} />
</Base>
