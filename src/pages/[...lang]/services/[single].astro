---
import Base from "@/layouts/Base.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils.ts";
import config from ".astro/config.generated.json";
import PageHeader from "@/components/widgets/PageHeader.astro";
import FeaturesGridThree from "@/components/sections/FeaturesGridThree.astro";
import StatsMarqueeSection from "@/components/sections/StatsMarqueeSection.astro";
import FaqSectionTwo from "@/components/sections/FaqSectionTwo.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { Schema } from "astro-seo-schema";
import type { Service, FAQPage } from "schema-dts";
import { absoluteUrl } from "@/lib/utils/absoluteUrl";
import trailingSlashChecker from "@/lib/utils/trailingSlashChecker";
import {
  getSanityService,
  getSanityServices,
  getSanityServicesIndex,
  serviceImageUrl,
} from "@/lib/sanity/services";
import SanityServiceContent from "@/components/widgets/SanityServiceContent.astro";

export async function getStaticPaths() {
  const services = await getSanityServices();
  const { defaultLanguage, showDefaultLangInUrl } =
    config.settings.multilingual;

  return services.flatMap((service) =>
    supportedLanguages.map((lang) => ({
      params: {
        lang:
          lang.languageCode === defaultLanguage && !showDefaultLangInUrl
            ? undefined
            : lang.languageCode,
        single: service.slug.current,
      },
      props: {
        service,
      },
    })),
  );
}

const { service: pathService } = Astro.props;
const service = pathService?.body
  ? pathService
  : await getSanityService(Astro.params.single || "");
const servicesIndex = await getSanityServicesIndex();

if (!service) return Astro.redirect("/404");
if (!servicesIndex) {
  throw new Error("Missing Sanity serviceIndex document.");
}

const baseUrl = trailingSlashChecker(Astro.url.origin);
const baseUrlClean = baseUrl.replace(/\/$/, "");
const orgData = config.seo.organization || {};

// Resolve canonical for this service page
const resolvedCanonical = service.seo?.canonical
  ? absoluteUrl(service.seo.canonical, Astro)
  : absoluteUrl(Astro.url.pathname, Astro);
const imageUrl = serviceImageUrl(service, 1200, 630);

// Build Service schema inline
const serviceSchema: Service = {
  "@type": "Service",
  "@id": `${resolvedCanonical}#service`,
  name: service.title,
  description: service.excerpt || service.seo?.metaDescription,
  url: resolvedCanonical,
  ...(imageUrl && { image: imageUrl }),
  provider: { "@id": `${baseUrlClean}/#organization` },
  serviceType: service.serviceType,
  areaServed: {
    "@type": "State",
    name: orgData.addressRegion || "USA",
  },
};

const faqList =
  servicesIndex.faqSection?.enable === true
    ? servicesIndex.faqSection.list
        ?.filter((item: any) => item.enable !== false)
        ?.map((item: any) => ({
          "@type": "Question",
          name: item.title,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.content,
          },
        })) || []
    : [];

let faqSchema: FAQPage | undefined;
if (faqList.length > 0) {
  faqSchema = {
    "@type": "FAQPage",
    "@id": `${resolvedCanonical}#faqpage`,
    mainEntity: faqList as any,
  };
}
---

<Base
  title={service.title}
  metaTitle={service.seo?.metaTitle || service.title}
  metaDescription={service.seo?.metaDescription || service.excerpt}
  canonical={service.seo?.canonical || resolvedCanonical}
  robots={service.seo?.robots}
  image={imageUrl}
  hideOffcanvas={true}>
  <PageHeader
    content={{
      badge: service.title,
      title: service.title,
      image: imageUrl,
      imageAlt: service.heroImage?.alt,
      imageText: service.title,
    }}
    contentClass="max-w-2xl!"
  />
  <SanityServiceContent value={service.body || []} />
  {
    servicesIndex.featureGrid && (
      <FeaturesGridThree content={servicesIndex.featureGrid} />
    )
  }
  {
    servicesIndex.statsMarquee && (
      <StatsMarqueeSection
        content={servicesIndex.statsMarquee}
        hasLightBackground={false}
      />
    )
  }
  {
    servicesIndex.faqSection && (
      <FaqSectionTwo content={servicesIndex.faqSection} mode="shadow" />
    )
  }
  {
    servicesIndex.ctaSection && (
      <CTASection content={servicesIndex.ctaSection} />
    )
  }

  <!-- Page-specific structured data -->
  <Schema
    item={{ "@context": "https://schema.org", ...serviceSchema } as any}
  />
  {
    faqSchema && (
      <Schema
        item={{ "@context": "https://schema.org", ...faqSchema } as any}
      />
    )
  }
</Base>
