---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import AboutHeroSection from "@/components/sections/AboutHeroSection.astro";
import FeaturesGrid from "@/components/sections/FeaturesGrid.astro";
import AboutSectionTwo from "@/components/sections/AboutSectionTwo.astro";
import StatsSection from "@/components/sections/StatsSection.astro";
import TeamSection from "@/components/sections/TeamSection.astro";
import CTAVideoSection from "@/components/sections/CTAVideoSection.astro";
import AboutMetricsSection from "@/components/sections/AboutMetricsSection.astro";
import TestimonialSectionTwo from "@/components/sections/TestimonialSectionTwo.astro";
import CTAGallerySection from "@/components/sections/CTAGallerySection.astro";
import BrandLogos from "@/components/sections/BrandLogos.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { Schema } from "astro-seo-schema";
import type { WebPage } from "schema-dts";
import { absoluteUrl } from "@/lib/utils/absoluteUrl";
import trailingSlashChecker from "@/lib/utils/trailingSlashChecker";
import { getSanityAboutPage } from "@/lib/sanity/pages";

export function getStaticPaths() {
  return generatePaths();
}

const page = (await getSanityAboutPage()) as any;
if (!page) return Astro.redirect("/404");

const baseUrl = trailingSlashChecker(Astro.url.origin);
const baseUrlClean = baseUrl.replace(/\/$/, "");
const resolvedCanonical = absoluteUrl(Astro.url.pathname, Astro);

// Build WebPage schema inline
const webPageSchema: WebPage = {
  "@type": "WebPage",
  "@id": `${resolvedCanonical}#webpage`,
  name: page?.title,
  description: page?.metaDescription || page?.description,
  url: resolvedCanonical,
  isPartOf: { "@id": `${baseUrlClean}/#website` },
};
---

<Base {...page} hideOffcanvas={true}>
  <AboutHeroSection content={page?.heroSection} />
  <FeaturesGrid content={(page as any)?.featuresGrid} hasLightBackground={true} />
  <AboutSectionTwo content={page?.aboutSectionTwo} />
  <StatsSection content={page?.statsSection} hasHalfBackground={true} />
  <TeamSection content={page?.teamSection} badgeVariant="secondary" />
  <CTAVideoSection content={page?.ctaVideoSection} />
  <AboutMetricsSection content={page?.aboutMetricsSection} hasLightBackground={true} />
  <TestimonialSectionTwo content={page?.testimonialSectionTwo} />
  <CTAGallerySection content={page?.ctaGallerySection} />
  <BrandLogos content={page?.brandLogos} />
  <CTASection />

  <!-- Page-specific structured data -->
  <Schema item={{ "@context": "https://schema.org", ...webPageSchema } as any} />
</Base>
