---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import BlogsHeroSection from "@/components/sections/BlogsHeroSection.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { getSanityBlogPosts } from "@/lib/sanity/client";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import config from ".astro/config.generated.json";
export async function getStaticPaths() {
  const posts = await getSanityBlogPosts();
  const pageSize = Number(config.settings.pagination) || 10;
  const totalPages = Math.ceil(posts.length / pageSize);
  const { defaultLanguage, showDefaultLangInUrl } = config.settings.multilingual;
  return supportedLanguages.flatMap((lang) => Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({ params: { slug: String(i + 2), lang: lang.languageCode === defaultLanguage && !showDefaultLangInUrl ? undefined : lang.languageCode } })));
}
const posts = await getSanityBlogPosts();
const currentPage = Number(Astro.params.slug) || 1;
---
<Base title={`Blog - Page ${currentPage}`} canonical={Astro.url.pathname}><PageHeader content={{ title: "Blog" }} contentClass="max-w-3xl! xl:px-6" /><BlogsHeroSection /><BlogLayout pageType="list" hasLightBackground={true} sidebar={{ enable: false }} content={{ ...posts[0], title: "Blog", slug: { current: "" }, publishedAt: "" }} posts={posts} contentList={{ options: { layout: "grid", columns: 2 }, pagination: { enable: true, currentPage } }} /><CTASection /></Base>
