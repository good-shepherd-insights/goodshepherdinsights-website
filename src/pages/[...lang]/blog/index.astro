---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import BlogsHeroSection from "@/components/sections/BlogsHeroSection.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import CTAGallerySection from "@/components/sections/CTAGallerySection.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { getSanityBlogPosts } from "@/lib/sanity/client";
import {
  blogImageUrl,
  blogPostUrl,
  sanityBlogPlaceholder,
} from "@/lib/sanity/blog";
import { getSanityBlogIndexPage } from "@/lib/sanity/pages";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { Schema } from "astro-seo-schema";
import { absoluteUrl } from "@/lib/utils/absoluteUrl";
import { buildSchemaIds } from "@/lib/seo/ids";
import { buildItemListSchema } from "@/lib/seo/itemList";
import { schemaGraph } from "@/lib/seo/types";
import { buildCollectionPageSchema } from "@/lib/seo/webpage";
const posts = await getSanityBlogPosts();
const blogIndex = await getSanityBlogIndexPage();
if (!blogIndex) {
  throw new Error(
    'Missing Sanity blogIndexPage document with id "blog-index-page".',
  );
}
export function getStaticPaths() {
  return generatePaths();
}
const {
  badge: blogBadge,
  title: blogTitle,
  metaDescription: blogDescription,
} = blogIndex;
const selfCanonical = absoluteUrl(Astro.url.pathname, Astro);
const schemaIds = buildSchemaIds(selfCanonical, Astro.url.href);
const collectionPageSchema = schemaGraph([
  buildCollectionPageSchema({
    ids: schemaIds,
    name: blogTitle,
    description: blogDescription,
  }),
  buildItemListSchema({
    id: schemaIds.itemList,
    itemType: "BlogPosting",
    baseUrl: schemaIds.baseUrl,
    items: posts.map((post) => ({
      name: post.seo?.metaTitle || post.title,
      url: blogPostUrl(post, Astro.currentLocale),
      description: post.seo?.metaDescription || post.excerpt,
      image: blogImageUrl(post, 1200, 630),
    })),
  }),
]);
---

<Base
  title={blogTitle}
  metaTitle={blogTitle}
  description={blogDescription}
  image={blogIndex.image}
  imageAlt={blogIndex.imageAlt}
  canonical={selfCanonical}
  schemaMainEntityId={schemaIds.itemList}>
  <PageHeader
    content={{ badge: blogBadge, title: blogTitle }}
    contentClass="max-w-3xl! xl:px-6"
  />
  <BlogsHeroSection />
  <BlogLayout
    pageType="list"
    hasLightBackground={true}
    sidebar={{
      enable: false,
    }}
    contentList={{
      options: { layout: "grid", columns: 2, search: true },
      searchSection: blogIndex.searchSection,
      pagination: { enable: true, currentPage: 1 },
    }}
    content={{
      ...sanityBlogPlaceholder,
      ...posts[0],
      title: blogTitle,
      slug: { current: "" },
      publishedAt: "",
    }}
    posts={posts}
  />
  <CTAGallerySection />
  <CTASection />
  <Schema item={collectionPageSchema as any} />
</Base>
