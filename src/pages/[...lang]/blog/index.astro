---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import BlogsHeroSection from "@/components/sections/BlogsHeroSection.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import CTAGallerySection from "@/components/sections/CTAGallerySection.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { getSanityBlogPosts } from "@/lib/sanity/client";
import { generatePaths } from "@/lib/utils/i18nUtils";
import { Schema } from "astro-seo-schema";
import { absoluteUrl } from "@/lib/utils/absoluteUrl";
const posts = await getSanityBlogPosts();
export function getStaticPaths() { return generatePaths(); }
const blogBadge = "Insights & Updates";
const blogTitle = "Practical guidance on ministry technology";
const blogDescription = "Strategic technology insights for ministries and churches.";
const selfCanonical = absoluteUrl(Astro.url.pathname, Astro);
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${selfCanonical}#collectionpage`,
  name: blogTitle,
  description: blogDescription,
  url: selfCanonical,
};
---
<Base title={blogTitle} metaTitle={blogTitle} description={blogDescription} canonical={selfCanonical}>
  <PageHeader content={{ badge: blogBadge, title: blogTitle }} contentClass="max-w-3xl! xl:px-6" />
  <BlogsHeroSection />
  <BlogLayout
    pageType="list"
    hasLightBackground={true}
    sidebar={{
      enable: false,
    }}
    contentList={{
      options: { layout: "grid", columns: 2 },
      pagination: { enable: true, currentPage: 1 },
    }}
    content={{ ...posts[0], title: blogTitle, slug: { current: "" }, publishedAt: "" }}
    posts={posts}
  />
  <CTAGallerySection />
  <CTASection />
  <Schema item={collectionPageSchema as any} />
</Base>
