---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import BlogsHeroSection from "@/components/sections/BlogsHeroSection.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import CTAGallerySection from "@/components/sections/CTAGallerySection.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { getSanityBlogPosts } from "@/lib/sanity/client";
import { generatePaths } from "@/lib/utils/i18nUtils";
const posts = await getSanityBlogPosts();
export function getStaticPaths() { return generatePaths(); }
---
<Base title="Blog" metaTitle="Blog"><PageHeader content={{ title: "Blog" }} contentClass="max-w-3xl! xl:px-6" /><BlogsHeroSection /><BlogLayout pageType="list" hasLightBackground={true} sidebar={{ enable: false }} content={{ ...posts[0], title: "Blog", slug: { current: "" }, publishedAt: "" }} posts={posts} contentList={{ options: { layout: "grid", columns: 2 }, pagination: { enable: true, currentPage: 1 } }} /><CTAGallerySection /><CTASection /></Base>
