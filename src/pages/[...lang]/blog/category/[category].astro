---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import BlogsHeroSection from "@/components/sections/BlogsHeroSection.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { getSanityBlogPosts } from "@/lib/sanity/client";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import { slugifyyy, titleify } from "@/lib/utils/textConverter";
import config from ".astro/config.generated.json";
export async function getStaticPaths() {
  const allPosts = await getSanityBlogPosts();
  const categories = [...new Set(allPosts.flatMap((post) => post.categories || []))];
  const { defaultLanguage, showDefaultLangInUrl } = config.settings.multilingual;
  return supportedLanguages.flatMap((lang) => categories.map((category) => ({ params: { category: slugifyyy(category), lang: lang.languageCode === defaultLanguage && !showDefaultLangInUrl ? undefined : lang.languageCode }, props: { category } })));
}
const allPosts = await getSanityBlogPosts();
const categories = [...new Set(allPosts.flatMap((post) => post.categories || []))];
const category = (Astro.props.category as string) || categories.find((name) => slugifyyy(name) === Astro.params.category);
const posts = allPosts.filter((post) => post.categories?.some((name) => slugifyyy(name) === Astro.params.category));
const title = titleify(`${category || "Category"} posts`);
---
<Base title={title} robots="noindex, follow"><PageHeader content={{ title: "Blog" }} contentClass="max-w-3xl! xl:px-6" /><BlogsHeroSection /><BlogLayout pageType="list" hasLightBackground={true} sidebar={{ enable: false }} content={{ ...posts[0], title, slug: { current: "" }, publishedAt: "" }} posts={posts} contentList={{ options: { layout: "grid", columns: 2 }, filter: { category: { name: category || "" } }, breadcrumbExcludedPaths: ["Category"] }} /><CTASection /></Base>
