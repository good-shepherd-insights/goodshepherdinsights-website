---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { getSanityBlogPost, getSanityBlogPosts } from "@/lib/sanity/client";
import { buildBlogPostSeo } from "@/lib/sanity/blogSeo";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import { absoluteUrl } from "@/lib/utils/absoluteUrl";
import { Schema } from "astro-seo-schema";
import config from ".astro/config.generated.json";

export async function getStaticPaths() {
  const { defaultLanguage, showDefaultLangInUrl } =
    config.settings.multilingual;
  return (await getSanityBlogPosts()).flatMap((post) =>
    supportedLanguages.map((lang) => ({
      params: {
        single: post.slug.current,
        lang:
          lang.languageCode === defaultLanguage && !showDefaultLangInUrl
            ? undefined
            : lang.languageCode,
      },
      props: { post, posts: [] },
    })),
  );
}
const { post: pathPost } = Astro.props;
const post = pathPost?.body
  ? pathPost
  : await getSanityBlogPost(Astro.params.single || "");
const posts = await getSanityBlogPosts();
if (!post) return Astro.redirect("/404");
const canonical = post.seo?.canonical
  ? absoluteUrl(post.seo.canonical, Astro)
  : absoluteUrl(Astro.url.pathname, Astro);
const seo = buildBlogPostSeo(post, {
  canonical,
  astro: Astro,
  inLanguage: Astro.currentLocale || "en-US",
});
---

<Base
  title={post.title}
  metaTitle={seo.title}
  metaDescription={seo.description}
  canonical={seo.canonical}
  robots={seo.robots}
  keywords={seo.keywords}
  author={seo.authorName}
  image={seo.image}
  imageAlt={seo.imageAlt}
  ogType="article"
  ogTitle={seo.socialTitle}
  ogDescription={seo.socialDescription}
  twitterTitle={seo.socialTitle}
  twitterDescription={seo.socialDescription}>
  <Fragment slot="head">
    <meta property="article:published_time" content={seo.publishedTime} />
    <meta property="article:modified_time" content={seo.modifiedTime} />
    {seo.authorUrl && <meta property="article:author" content={seo.authorUrl} />}
    {seo.section && <meta property="article:section" content={seo.section} />}
    {seo.tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>
  <PageHeader
    content={{
      title: post.title,
      badge: post.categories?.[0],
      image: seo.image,
      imageAlt: seo.imageAlt,
      postData: {
        date: new Date(post.publishedAt),
        author: seo.authorName,
      },
    }}
    contentClass=""
  />
  <Schema item={{ "@context": "https://schema.org", ...seo.schema } as any} />
  <BlogLayout
    sidebar={{ enable: true, sticky: true }}
    content={post}
    posts={posts}
  />
  <CTASection hasNoLightBackground={true} />
</Base>
