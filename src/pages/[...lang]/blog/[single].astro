---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { getSanityBlogPost, getSanityBlogPosts } from "@/lib/sanity/client";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import { absoluteUrl } from "@/lib/utils/absoluteUrl";
import config from ".astro/config.generated.json";
export async function getStaticPaths() {
  const { defaultLanguage, showDefaultLangInUrl } = config.settings.multilingual;
  return (await getSanityBlogPosts()).flatMap((post) =>
    supportedLanguages.map((lang) => ({
      params: { single: post.slug.current, lang: lang.languageCode === defaultLanguage && !showDefaultLangInUrl ? undefined : lang.languageCode },
      props: { post, posts: [] },
    })),
  );
}
const { post: pathPost } = Astro.props;
const post =
  pathPost?.body
    ? pathPost
    : await getSanityBlogPost(Astro.params.single || "");
const posts = await getSanityBlogPosts();
if (!post) return Astro.redirect("/404");
const canonical = absoluteUrl(Astro.url.pathname, Astro);
---
<Base title={post.title} metaTitle={post.title} metaDescription={post.excerpt} canonical={canonical} image={post.coverImage?.asset ? undefined : undefined}>
  <PageHeader content={{ title: post.title, badge: post.categories?.[0], postData: { date: new Date(post.publishedAt), author: "Good Shepherd Insights" } }} contentClass="" />
  <BlogLayout sidebar={{ enable: true, sticky: true }} content={post} posts={posts} />
  <CTASection hasNoLightBackground={true} />
</Base>
