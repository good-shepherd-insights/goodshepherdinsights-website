---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import BlogsHeroSection from "@/components/sections/BlogsHeroSection.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import CTASection from "@/components/sections/CTASection.astro";
import CTAGallerySection from "@/components/sections/CTAGallerySection.astro";
import { getSanityBlogPosts } from "@/lib/sanity/client";
import { sanityBlogPlaceholder } from "@/lib/sanity/blog";
import { getSanityBlogIndexPage } from "@/lib/sanity/pages";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import { slugifyyy, titleify } from "@/lib/utils/textConverter";
import config from ".astro/config.generated.json";
import { Schema } from "astro-seo-schema";
import { absoluteUrl } from "@/lib/utils/absoluteUrl";
export async function getStaticPaths() {
  const allPosts = await getSanityBlogPosts();
  const tags = [...new Set(allPosts.flatMap((post) => post.tags || []))];
  const { defaultLanguage, showDefaultLangInUrl } =
    config.settings.multilingual;
  return supportedLanguages.flatMap((lang) =>
    tags.map((tag) => ({
      params: {
        tag: slugifyyy(tag),
        lang:
          lang.languageCode === defaultLanguage && !showDefaultLangInUrl
            ? undefined
            : lang.languageCode,
      },
      props: { tag },
    })),
  );
}
const allPosts = await getSanityBlogPosts();
const blogIndex = await getSanityBlogIndexPage();
if (!blogIndex) {
  throw new Error('Missing Sanity blogIndexPage document with id "blog-index-page".');
}
const tags = [...new Set(allPosts.flatMap((post) => post.tags || []))];
const tag =
  (Astro.props.tag as string) ||
  tags.find((name) => slugifyyy(name) === Astro.params.tag);
const taxonomyCopy = blogIndex.taxonomyCopy;
if (!tag || !taxonomyCopy?.categoryTitleSuffix || !taxonomyCopy?.tagDescriptionPrefix) {
  throw new Error('Missing required Sanity blogIndexPage taxonomy copy for tag page.');
}
const posts = allPosts.filter((post) =>
  post.tags?.some((name) => slugifyyy(name) === Astro.params.tag),
);
const title = titleify(`${tag} ${taxonomyCopy.categoryTitleSuffix}`);
const description = `${taxonomyCopy.tagDescriptionPrefix} ${tag}.`;
const selfCanonical = absoluteUrl(Astro.url.pathname, Astro);
const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${selfCanonical}#collectionpage`,
  name: title,
  description,
  url: selfCanonical,
};
---

<Base
  title={title}
  metaDescription={description}
  robots="noindex, follow"
  canonical={selfCanonical}>
  <PageHeader
    content={blogIndex}
    contentClass="max-w-3xl! xl:px-6"
  />
  <BlogsHeroSection />
  <BlogLayout
    pageType="list"
    hasLightBackground={true}
    sidebar={{
      enable: false,
    }}
    contentList={{
      options: { layout: "grid", columns: 2, search: true },
      searchSection: blogIndex.searchSection,
      filter: { tag: { name: tag || "" } },
      breadcrumbExcludedPaths: ["Tag"],
    }}
    content={{
      ...sanityBlogPlaceholder,
      ...posts[0],
      title,
      slug: { current: "" },
      publishedAt: "",
    }}
    posts={posts}
  />
  <CTAGallerySection />
  <CTASection />
  <Schema item={collectionPageSchema as any} />
</Base>
