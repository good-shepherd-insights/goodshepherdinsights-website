---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import BlogsHeroSection from "@/components/sections/BlogsHeroSection.astro";
import BlogLayout from "@/components/BlogLayout.astro";
import CTASection from "@/components/sections/CTASection.astro";
import { getSanityBlogPosts } from "@/lib/sanity/client";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import { slugifyyy, titleify } from "@/lib/utils/textConverter";
import config from ".astro/config.generated.json";
export async function getStaticPaths() {
  const allPosts = await getSanityBlogPosts();
  const tags = [...new Set(allPosts.flatMap((post) => post.tags || []))];
  const { defaultLanguage, showDefaultLangInUrl } = config.settings.multilingual;
  return supportedLanguages.flatMap((lang) => tags.map((tag) => ({ params: { tag: slugifyyy(tag), lang: lang.languageCode === defaultLanguage && !showDefaultLangInUrl ? undefined : lang.languageCode }, props: { tag } })));
}
const allPosts = await getSanityBlogPosts();
const tags = [...new Set(allPosts.flatMap((post) => post.tags || []))];
const tag = (Astro.props.tag as string) || tags.find((name) => slugifyyy(name) === Astro.params.tag);
const posts = allPosts.filter((post) => post.tags?.some((name) => slugifyyy(name) === Astro.params.tag));
const title = titleify(`${tag || "Tag"} posts`);
---
<Base title={title} robots="noindex, follow"><PageHeader content={{ title: "Blog" }} contentClass="max-w-3xl! xl:px-6" /><BlogsHeroSection /><BlogLayout pageType="list" hasLightBackground={true} sidebar={{ enable: false }} content={{ ...posts[0], title, slug: { current: "" }, publishedAt: "" }} posts={posts} contentList={{ options: { layout: "grid", columns: 2 }, filter: { tag: { name: tag || "" } }, breadcrumbExcludedPaths: ["Tag"] }} /><CTASection /></Base>
