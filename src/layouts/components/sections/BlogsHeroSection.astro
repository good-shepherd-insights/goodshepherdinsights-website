---
import Icons from "@/helpers/Icons.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { getSanityBlogPosts } from "@/lib/sanity/client";
import { blogImageUrl, blogPostUrl } from "@/lib/sanity/blog";
const posts = (await getSanityBlogPosts()).slice(0, 5);
if (!posts.length) return;
---
<section class="relative"><div class="bg-light absolute top-76 bottom-0 left-0 z-[-1] h-full w-full md:top-100" /><div class="relative container"><div id="blog-hero-slider" class="swiper overflow-hidden" aria-label="Blog posts slider"><div class="swiper-wrapper box-content flex w-full">
{posts.map((post, i) => <div class="swiper-slide h-auto! w-full shrink-0"><a href={blogPostUrl(post, Astro.currentLocale)} class="group relative block">{blogImageUrl(post, 1200, 550) && <img src={blogImageUrl(post, 1200, 550)} alt={post.coverImage?.alt || post.title} width="1200" height="550" class="h-112.5 w-full object-cover md:h-137.5" loading={i === 0 ? "eager" : "lazy"} />}<div class="absolute inset-0 bg-black/40" /><div class="bg-light absolute bottom-0 left-1/2 w-full max-w-xl -translate-x-1/2 rounded-t-lg px-8 py-6 text-center shadow-lg md:px-10 md:py-8"><div class="text-dark/60 mb-3 flex items-center justify-center gap-3 text-sm">{post.categories?.[0]}<span class="bg-dark/30 inline-block h-3 w-px" />{dateFormat(post.publishedAt, "dd MMMM yyyy")}</div><div class="text-dark text-h5 sm:text-h4-sm mb-3 leading-snug">{post.title}</div>{post.excerpt && <p class="text-text-dark/85 line-clamp-2 leading-relaxed">{post.excerpt}</p>}</div></a></div>)}
</div><button class="blog-slider-btn-prev bg-primary text-text-light absolute inset-s-0 top-1/2 z-10 flex min-h-16 min-w-16 -translate-y-1/2 items-center justify-center" aria-label="Previous slide"><Icons icon="ArrowLeft" class="size-7" /></button><button class="blog-slider-btn-next bg-primary text-text-light absolute inset-e-0 top-1/2 z-10 flex min-h-16 min-w-16 -translate-y-1/2 items-center justify-center" aria-label="Next slide"><Icons icon="ArrowRight" class="size-7" /></button></div></div></section>
<script>
  const { Swiper } = await import("swiper");
  const { Autoplay, Navigation } = await import("swiper/modules");
  const element = document.querySelector("#blog-hero-slider") as HTMLElement | null;
  if (element) new Swiper(element, { modules: [Autoplay, Navigation], navigation: { nextEl: ".blog-slider-btn-next", prevEl: ".blog-slider-btn-prev" }, autoplay: { delay: 5000 }, loop: true });
</script>
