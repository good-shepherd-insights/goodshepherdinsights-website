---
import ServiceCard from "@/components/cards/ServiceCard.astro";
import { getSanityServices } from "@/lib/sanity/services";

type Props = {
  content?: {
    enable?: boolean;
    layout?: "horizontal" | "listImage";
    limit?: number;
  };
  hasPaddingBottom?: boolean;
};

const { content, hasPaddingBottom = false } = Astro.props;
if (content?.enable === false) return;

const services = await getSanityServices();
const servicesList = content?.limit
  ? services.slice(0, content.limit)
  : services;
const layout = content?.layout || "listImage";
---

<section
  class:list={[
    "bg-light relative",
    hasPaddingBottom && "section-spacing-bottom",
  ]}>
  <div class="container flex flex-col gap-8 lg:gap-12">
    {
      servicesList && servicesList.length > 0 && (
        <div class="divide-border-dark border-border-dark group/list relative divide-y border-y">
          {servicesList.map((service, index) => (
            <ServiceCard
              content={service}
              options={{ layout }}
              index={index}
              tag="h2"
            />
          ))}
        </div>
      )
    }
  </div>
</section>
