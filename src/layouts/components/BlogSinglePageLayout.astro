---
import PaginationForSingle from "./widgets/PaginationForSingle.astro";
import { portableTextToHtml } from "@/lib/sanity/portableText";
import { blogImageUrl } from "@/lib/sanity/blog";
import type { SanityBlogPost } from "@/lib/sanity/client";
interface Props { content: SanityBlogPost; class?: string; posts: SanityBlogPost[]; }
const { content, class: className, posts } = Astro.props;
---
<div class:list={["blog-details has-video-modal space-y-10 lg:col-span-8", className]}>
  {content.coverImage?.asset && <img src={blogImageUrl(content, 896, 500)} alt={content.coverImage.alt || content.title} width="896" height="500" class="h-auto w-full rounded-xl object-cover" loading="eager" />}
  <div class="prose-styles content has-video-modal" set:html={portableTextToHtml(content.body || [])} />
  {content.tags?.length && <div class="border-border-dark/20 flex w-full flex-wrap gap-3 border-y py-4 lg:py-8">{content.tags.map((tag) => <span class="bg-light rounded-md px-4 py-1.5 text-sm capitalize">{tag}</span>)}</div>}
  <PaginationForSingle posts={posts} currentSlug={content.slug.current} />
</div>
