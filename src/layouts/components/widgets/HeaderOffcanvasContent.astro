---
import Icons from "@/helpers/Icons.astro";
import Logo from "../global/Logo.astro";
import { markdownify } from "@/lib/utils/textConverter";
import Social from "./Social.astro";
import Button from "@/components/Button.astro";
import Navbar from "../global/header/Navbar.astro";
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import type {
  GlobalBrand,
  GlobalContact,
  SiteGlobals,
} from "@/lib/sanity/siteGlobals";

const { offcanvas: offcanvasId, brand, header, contact, socialLinks = [] } =
  Astro.props as {
    offcanvas: string;
    brand: GlobalBrand;
    header: SiteGlobals["header"];
    contact: GlobalContact;
    socialLinks?: SiteGlobals["socialLinks"];
  };
const { offcanvas } = header;
const phoneMarkdown = contact.phoneHref
  ? `[${contact.phoneLabel}](${contact.phoneHref})`
  : contact.phoneLabel;
const emailMarkdown = contact.emailHref
  ? `[${contact.emailLabel}](${contact.emailHref})`
  : contact.emailLabel;

if (!offcanvas?.enable) {
  return null;
}
---

<div
  class="bg-light h-screen space-y-10 overflow-auto px-8 pt-20 pb-5 md:px-16 md:pt-32 md:pb-10">
  <button
    type="button"
    data-hs-overlay={`#${offcanvasId}`}
    title="Close offcanvas"
    class="border-border-light hover:border-border-dark bg-body absolute inset-e-7 top-5 z-20 inline-flex h-14 w-14 items-center justify-center gap-x-2 rounded-full border-2 text-sm font-medium transition-all duration-500 ease-out hover:rotate-90"
    aria-expanded="true">
    <Icons icon="X" class="text-2xl" />
  </button>

  <Logo brand={brand} class="justify-start" />
  <div class="lg:border-b lg:pb-10">
    {
      offcanvas.description && (
        <p
          class="text-lg"
          set:html={markdownify(offcanvas.description)}
        />
      )
    }
  </div>
  <div class="border-border-dark/10 border-y py-10 xl:hidden">
    <Navbar
      isMobile={true}
      items={header.primaryNavigation}
      navigationButton={header.navigationButton}
    />
  </div>

  <div class="prose-a:hover:text-accent prose-a: font-secondary text-base">
    {contact.addressText && <address class="not-italic">{contact.addressText}</address>}
    {phoneMarkdown && <p set:html={markdownify(phoneMarkdown)} />}
    {emailMarkdown && <p set:html={markdownify(emailMarkdown)} />}
  </div>

  <div class="flex items-center">
    <Social
      linkType="follow"
      slug={getLocaleUrlCTM(Astro.url.pathname, Astro.currentLocale)}
      layout="minimal"
      list={socialLinks.filter((social) => social.enable !== false).slice(0, 4)}
      size="lg"
    />
  </div>

  {
    offcanvas.button?.enable && offcanvas.button?.label && (
      <Button
        variant="circle"
        hoverEffect="magnetic"
        class="btn-accent m-0 ms-auto hidden justify-center lg:flex"
        {...offcanvas.button}
      />
    )
  }
</div>
