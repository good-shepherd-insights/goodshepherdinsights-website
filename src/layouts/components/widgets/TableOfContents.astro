---
import RecursiveToc from "@/layouts/components/widgets/RecursiveToc.astro";
import Icons from "@/helpers/Icons.astro";
import type { MarkdownHeading } from "astro";

type CustomHeading = MarkdownHeading & {
  subheadings?: CustomHeading[];
};

interface Props {
  toc: CustomHeading[];
  marker?: boolean;
  className?: string;
  title?: string;
  expanded?: boolean;
}

const {
  toc,
  className,
  marker = true,
  title = "Table of Contents",
  expanded = true,
  ...rest
} = Astro.props;

if (!toc) return;

const instanceId = Math.random().toString(36).substring(2, 9);
const tocId = `toc-collapse-${instanceId}`;
const toggleId = `toc-toggle-${instanceId}`;
---

<details
  class:list={["hs-accordion group", className]}
  open={expanded}
  {...rest}>
  <summary
    id={toggleId}
    class="hs-accordion-toggle border-border-dark/25 text-dark mb-2 flex w-full list-none items-center justify-between border-b pb-2 select-none [&::-webkit-details-marker]:hidden"
    aria-controls={tocId}>
    <span
      class="text-base-sm font-primary font-normal tracking-widest uppercase md:text-base">
      {title}
    </span>
    <span
      class="flex h-9 w-9 items-center justify-center rounded-full transition duration-300 group-open:rotate-180">
      <Icons icon="ChevronDown" />
    </span>
  </summary>
  <nav
    id={tocId}
    aria-labelledby={toggleId}
    class:list={[
      "toc prose-styles prose-a:text-text-dark prose-ul:ps-0 overflow-hidden",
      marker && "scroll-menu",
    ]}>
    <ol class="has-customized-scrollbar max-h-60 overflow-auto">
      {
        toc.map((heading) => (
          <li>
            <a href={`#${heading.slug}`}>{heading.text}</a>
            <RecursiveToc toc={heading.subheadings} />
          </li>
        ))
      }
    </ol>
  </nav>
  <script define:vars={{ marker, tocId }}>
    import { ScrollMenu } from "@/plugins/scroll-menu.ts";

    document.addEventListener("DOMContentLoaded", function () {
      if (!marker) return;

      const toc = document.querySelector(`#${tocId} > ol`) as HTMLElement | null;
      if (!toc) return;

      new ScrollMenu(`#${tocId} a`, {
        activeOffset: 128,
        scrollOffset: 128,
        smoothScroll: false,

        afterActive: (activeItem) => {
          const offset = activeItem.offsetTop + 3;
          toc.setAttribute("style", `--active-offset: ${offset}px`);
        },
      });
    });
  </script>
</details>
