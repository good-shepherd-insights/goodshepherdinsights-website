---
import BlogCard from "@/components/cards/BlogCard.astro";
import { getSanityBlogPosts } from "@/lib/sanity/client";
import { useTranslations } from "@/lib/utils/i18nUtils";
const t = await useTranslations(Astro.currentLocale as string);
const currentSlug = Astro.props.currentPost?.slug?.current;
const posts = (await getSanityBlogPosts()).filter((post) => post.slug.current !== currentSlug).slice(0, 3);
---
{posts.length > 0 && <div class="bg-light rounded-lg p-4 xl:p-8"><h2 class="text-h6 xl:text-h5 mb-5 xl:mb-8">{t("widgets.recentPostsTitle")}</h2><div class="space-y-4.5">{posts.map((post) => <BlogCard content={post} options={{ layout: "compact" }} />)}</div></div>}
