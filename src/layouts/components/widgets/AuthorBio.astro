---
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { getSiteGlobals } from "@/lib/sanity/siteGlobals";

const siteGlobals = await getSiteGlobals();
if (!siteGlobals) {
  throw new Error('Missing required Sanity siteGlobals document with _id "site-globals"');
}
const uiCopy = siteGlobals.uiCopy?.copy ? JSON.parse(siteGlobals.uiCopy.copy) : {};

const {
  authorName = siteGlobals.seoDefaults?.author || siteGlobals.brand.title,
  authorBio = uiCopy.blog?.defaultAuthorBio,
  authorImage = "/images/team/team-1.png",
  authorUrl = "/about",
} = Astro.props;
const authorRole = uiCopy.blog?.defaultAuthorRole;
const learnMorePrefix = uiCopy.common?.learnMoreAbout;
---

<section class="section-padding">
  <div class="container">
    <div class="items-center gap-8 md:flex">
      <div class="mb-6 shrink-0 md:mb-0">
        <OptimizedImage
          src={authorImage}
          alt={authorName}
          width={120}
          height={120}
          class="rounded-full"
        />
      </div>
      <div class="text-center md:text-left">
        <p class="text-dark font-secondary text-xl font-bold">{authorName}</p>
        <p class="text-dark/70 mt-1 text-sm font-medium uppercase tracking-wider">
          {authorRole}
        </p>
        <p class="text-dark/60 mt-4 leading-relaxed">{authorBio}</p>
        <a
          href={authorUrl}
          class="text-primary mt-4 inline-block font-medium hover:underline"
        >
          {learnMorePrefix} {authorName} &rarr;
        </a>
      </div>
    </div>
  </div>
</section>
