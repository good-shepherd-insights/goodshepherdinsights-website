---
import Icons from "@/helpers/Icons.astro";
import { markdownify } from "@/lib/utils/textConverter";
import uniqueIdGenerator from "@/lib/utils/uniqueIdGenerator";

type AccordionItem = {
  title: string;
  content: string;
  contentIsHtml?: boolean;
};

interface Props {
  content: AccordionItem[];
  class?: string;
  mode?: "light" | "dark" | "transparent" | "shadow";
  [key: string]: any;
}

const { content: list, mode = "light", ...rest } = Astro.props;
const instanceId = Math.random().toString(36).substring(2, 9);
---

<div
  class="hs-accordion-group mx-auto flex w-full flex-col gap-4"
  {...rest}
  data-hs-accordion-always-open={rest["data-hs-accordion-always-open"]}>
  {
    list.map((item, index: number) => {
      const id = uniqueIdGenerator(item.title);
      const accordionId = `accordion-${instanceId}-${id}`;
      const contentId = `content-${instanceId}-${id}`;
      const toggleId = `${accordionId}-toggle`;

      return (
        <details
          class:list={[
            "hs-accordion group relative px-4 py-1 text-start transition-all lg:px-6",
            mode === "dark"
              ? "bg-light"
              : mode === "transparent"
                ? "border-primary/40 text-text-light border bg-transparent"
                : mode === "shadow"
                  ? "bg-light shadow-lg"
                  : "bg-body open:bg-accent",
          ]}
          id={accordionId}
          open={index === 0}>
          <summary
            id={toggleId}
            class:list={[
              "hs-accordion-toggle font-secondary text-h6 flex w-full list-none items-center justify-between border-b border-transparent py-5.5 text-start font-medium select-none [&::-webkit-details-marker]:hidden",
              mode === "transparent"
                ? "group-open:border-primary/40 group-open:text-accent"
                : mode === "shadow"
                  ? "group-open:border-border-dark/10"
                  : "group-open:border-border-light",
            ]}
            aria-controls={contentId}>
            <span
              data-accordion-title
              set:html={markdownify(item.title)}
              class="text-h6 sm:text-h6-sm text-inherit"
            />
            <div class="pointer-events-none flex text-inherit transition duration-300 group-open:-rotate-90">
              <Icons icon="ArrowDownRight" class="text-xl" />
            </div>
          </summary>
          <div
            role="region"
            id={contentId}
            aria-labelledby={toggleId}
            class="hs-accordion-content w-full overflow-hidden">
            <div class="py-4">
              {
                item.contentIsHtml ? (
                  <div
                    set:html={item.content}
                    class:list={["text-inherit opacity-90"]}
                  />
                ) : (
                  <div
                    set:html={markdownify(item.content, false)}
                    class:list={["text-inherit opacity-90"]}
                  />
                )
              }
            </div>
          </div>
        </details>
      );
    })
  }
</div>
