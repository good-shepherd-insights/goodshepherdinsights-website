---
import { getSanityBlogPosts } from "@/lib/sanity/client";
import { blogTaxonomyUrl, tagCounts } from "@/lib/sanity/blog";
import { useTranslations } from "@/lib/utils/i18nUtils";
const t = await useTranslations(Astro.currentLocale as string);
const tags = tagCounts(await getSanityBlogPosts()).sort((a,b) => b.count-a.count);
---
{tags.length > 0 && <div class="bg-light rounded-lg p-4 xl:p-8"><h2 class="text-h6 xl:text-h5 mb-5 xl:mb-8">{t("widgets.popularTagsTitle")}</h2><div class="flex flex-wrap gap-3">{tags.map((tag) => <a href={blogTaxonomyUrl("tag", tag.name, Astro.currentLocale)} class="bg-body hover:bg-accent inline-block rounded-md px-4 py-1 font-medium capitalize">{tag.name} ({tag.count})</a>)}</div></div>}
