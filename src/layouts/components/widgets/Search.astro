---
import Icons from "@/helpers/Icons.astro";
import { getSanityBlogPosts } from "@/lib/sanity/client";
import { blogPostUrl, blogImageUrl } from "@/lib/sanity/blog";
const posts = await getSanityBlogPosts();
---
<div class="bg-light rounded-lg p-4 lg:p-8"><form data-sanity-search class="relative flex rounded-lg"><input name="search" type="search" class="form-input h-full w-full rounded-md border-none" placeholder="Search posts" /><button class="btn-accent absolute top-0 right-0 flex size-11 items-center justify-center" aria-label="Search"><Icons icon="Search" class="size-5" /></button></form><div data-sanity-results class="mt-5 hidden space-y-3" /></div>
<script is:inline define:vars={{ posts: posts.map((post) => ({ title: post.title, excerpt: post.excerpt || "", href: blogPostUrl(post, Astro.currentLocale), image: blogImageUrl(post, 120, 80) || "" })) }}>
const form = document.querySelector("[data-sanity-search]"), input = form?.querySelector("input"), results = document.querySelector("[data-sanity-results]");
form?.addEventListener("submit", (event) => { event.preventDefault(); const term = input?.value.trim().toLowerCase() || ""; const matches = posts.filter((post) => `${post.title} ${post.excerpt}`.toLowerCase().includes(term)); if (!results) return; results.classList.toggle("hidden", !term); results.innerHTML = matches.map((post) => `<a href="${post.href}" class="block text-sm font-semibold">${post.title}</a>`).join("") || `<p class="text-sm">No posts found.</p>`; });
</script>
