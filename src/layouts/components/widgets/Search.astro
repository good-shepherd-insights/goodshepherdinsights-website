---
import Icons from "@/helpers/Icons.astro";
import { getSanityBlogPosts } from "@/lib/sanity/client";
import { blogPostUrl, blogImageUrl } from "@/lib/sanity/blog";
const posts = await getSanityBlogPosts();
---

<div class="mb-6 space-y-4 lg:mb-14 lg:space-y-10">
  <h2 class="text-dark text-h5 text-center">Check our inside News</h2>
  <form
    data-sanity-search
    class="border-border-dark mx-auto flex max-w-md items-stretch overflow-hidden border-b">
    <input
      name="search"
      type="search"
      class="text-dark h-full w-full border-none bg-transparent py-2 pr-10 pl-0 outline-0 focus:shadow-none focus:ring-0"
      placeholder="Search in blog"
    />
    <button
      class="text-text-dark items-center justify-center bg-transparent p-0"
      aria-label="Search">
      <Icons icon="Search" class="size-5" />
    </button>
  </form>
  <div data-sanity-results class="mx-auto hidden max-w-md space-y-3"></div>
</div>
<script
  is:inline
  define:vars={{
    posts: posts.map((post) => ({
      title: post.title,
      excerpt: post.excerpt || "",
      href: blogPostUrl(post, Astro.currentLocale),
      image: blogImageUrl(post, 120, 80) || "",
    })),
  }}
>
  const form = document.querySelector("[data-sanity-search]"),
    input = form?.querySelector("input"),
    results = document.querySelector("[data-sanity-results]");
  const escapeHtml = (value) =>
    value.replace(
      /[&<>"']/g,
      (character) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[character],
    );
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const term = input?.value.trim().toLowerCase() || "";
    const matches = posts.filter((post) =>
      `${post.title} ${post.excerpt}`.toLowerCase().includes(term),
    );
    if (!results) return;
    results.classList.toggle("hidden", !term);
    results.innerHTML =
      matches
        .map(
          (post) =>
            `<a href="${escapeHtml(post.href)}" class="block text-sm font-semibold">${escapeHtml(post.title)}</a>`,
        )
        .join("") || `<p class="text-sm">No posts found.</p>`;
  });
</script>
