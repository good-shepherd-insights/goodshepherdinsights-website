---
import { getLocaleUrlCTM, useTranslations } from "@/lib/utils/i18nUtils.ts";
import Button from "@/components/Button.astro";
import type { SanityBlogPost } from "@/lib/sanity/client";

interface Props {
  prevBtnText?: string;
  posts?: SanityBlogPost[];
  nextBtnText?: string;
  currentSlug?: string;
  class?: string;
}

const t = await useTranslations(Astro.currentLocale as string);

let {
  prevBtnText = t("common.paginationPrevious"),
  nextBtnText = t("common.paginationNext"),
  posts,
  currentSlug,
  class: className,
} = Astro.props;

let prevPage: SanityBlogPost | undefined;
let nextPage: SanityBlogPost | undefined;
let prevHref: string | undefined;
let nextHref: string | undefined;
if (posts && currentSlug) {
  const currentIndex = posts.findIndex(
    (item) => item.slug.current === currentSlug,
  );
  if (currentIndex !== -1) {
    prevPage = posts[currentIndex + 1];
    nextPage = posts[currentIndex - 1];
    prevHref =
      prevPage &&
      getLocaleUrlCTM(`/blog/${prevPage.slug.current}`, Astro.currentLocale);
    nextHref =
      nextPage &&
      getLocaleUrlCTM(`/blog/${nextPage.slug.current}`, Astro.currentLocale);
  }
}
---

<nav
  id="pagination"
  class:list={[
    "flex w-full flex-wrap items-center justify-between gap-3 font-normal",
    className,
  ]}
  aria-label="Pagination">
  {/* previous */}
  {
    prevHref && (
      <Button
        variant="text"
        icon={{
          enable: true,
          name: "ArrowRight",
          position: "left",
        }}
        url={prevHref}
        label={prevBtnText}
        class="hover:text-primary me-auto flex flex-row-reverse items-center gap-2 border-transparent [&_.icons-wrapper]:scale-x-[-1]"
      />
    )
  }

  {/* next page */}
  {
    nextHref && (
      <Button
        icon={{
          enable: true,
          name: "ArrowRight",
          position: "left",
        }}
        variant="text"
        url={nextHref}
        label={nextBtnText}
        class="hover:text-primary ms-auto border-transparent"
      />
    )
  }
</nav>
