---
import {
  getServiceFitRender,
  getServiceProcessRender,
  type SanityServiceBlock,
} from "@/lib/sanity/services";
import ServiceFitQualification from "../../../components/widgets/ServiceFitQualification.astro";
import ServiceEngagementProcess from "../../../components/widgets/ServiceEngagementProcess.astro";

interface Props {
  value: SanityServiceBlock[];
  class?: string;
  service?: import("@/lib/sanity/services").SanityService;
}

const { value = [], class: className, service } = Astro.props as Props;

// All legacy block rendering (serviceIntro, serviceNarrative, statCallout,
// serviceOffering, serviceCta) removed — content preserved in Sanity for
// repurposing. textHtml/videoModalId/ctaUrl restore with it when dedicated
// components (4/5) are built.

// Precompute fit + process renders keyed by body index (components need the
// full service document to resolve their CTA from the sibling serviceCta block).
const fitRenders = value.map((block) =>
  block._type === "serviceFit" && service
    ? getServiceFitRender(block, service)
    : null,
);
const processRenders = value.map((block) =>
  block._type === "serviceProcess" && service
    ? getServiceProcessRender(block, service)
    : null,
);
---

<section
  class:list={[
    "bg-light overflow-hidden pt-0!",
    className,
  ]}>
  {
    // Full-bleed blocks (serviceFit, serviceProcess) render at section level so
    // their background spans the viewport. All legacy block rendering is removed
    // (content preserved in Sanity for repurposing into components 4/5).
    value.map((block, index) =>
      block._type === "serviceFit" && fitRenders[index] ? (
        <ServiceFitQualification
          id={`service-fit-${block._key}`}
          content={fitRenders[index]!.content}
          variant={fitRenders[index]!.variant}
          headingLevel="h2"
        />
      ) : block._type === "serviceProcess" && processRenders[index] ? (
        <ServiceEngagementProcess
          id={`service-process-${block._key}`}
          content={processRenders[index]!.content}
          variant={processRenders[index]!.variant}
          headingLevel="h2"
        />
      ) : null,
    )
  }
</section>
