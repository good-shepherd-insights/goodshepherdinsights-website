---
import { Schema } from "astro-seo-schema";
import type { SiteGlobals } from "@/lib/sanity/siteGlobals";
import { buildStandardPageGraph } from "@/lib/seo/schemaGraph";

const {
  title = "",
  description,
  metaDescription,
  canonical = "",
  schemaMainEntityId,
  siteGlobals,
} = Astro.props as {
  title?: string;
  description?: string;
  metaDescription?: string;
  canonical?: string;
  schemaMainEntityId?: string;
  siteGlobals?: SiteGlobals;
};

const uiCopy = siteGlobals?.uiCopy?.copy
  ? JSON.parse(siteGlobals.uiCopy.copy)
  : {};
const homeLabel = uiCopy?.common?.home;
if (!homeLabel) {
  throw new Error("Missing required Sanity uiCopy.common.home value.");
}

const schema = buildStandardPageGraph({
  title,
  description: metaDescription || description,
  canonical,
  currentUrl: Astro.url.href,
  siteGlobals,
  homeLabel,
  mainEntityId: schemaMainEntityId,
});
---

<Schema item={schema as any} />
