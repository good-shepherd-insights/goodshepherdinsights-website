---
import NavMenuItem from "@/layouts/components/global/header/MenuItem.astro";
import Button from "@/components/Button.astro";
import type { GlobalButton, NavigationItem } from "@/lib/sanity/siteGlobals";

interface Props {
  isMobile?: boolean;
  hasActiveBorder?: boolean;
  items?: NavigationItem[];
  navigationButton?: GlobalButton;
}

const {
  isMobile,
  hasActiveBorder = false,
  items = [],
  navigationButton,
} = Astro.props as Props;
const main = items.filter((item) => item.enable !== false);
---

<ul
  id="nav-menu"
  class:list={[
    "navbar hs-dropdown-menu focus:outline-none lg:flex!",
    hasActiveBorder && "navbar-active-border",
    isMobile && "navbar-mobile",
  ]}
  role="menu">
  {main.map((menu) => <NavMenuItem isMobile={isMobile} menu={menu} />)}
  {/* Navigation Button For Small Devices */}
  {
    navigationButton?.enable && navigationButton?.label && (
      <li class="max-lg:pt-2 lg:hidden" role="menuitem">
        <Button
          hoverEffect="creative-fill"
          {...navigationButton}
          class="btn-accent effect-color-dark"
        />
      </li>
    )
  }
</ul>
