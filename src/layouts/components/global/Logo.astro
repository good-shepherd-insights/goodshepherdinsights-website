---
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils.ts";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { markdownify, toSentenceCase } from "@/lib/utils/textConverter";
import type { GlobalBrand } from "@/lib/sanity/siteGlobals";

type Props = {
  src?: string;
  brand?: GlobalBrand;
  class?: string;
  width?: string;
  height?: string;
  [key: string]: any;
};

let { src, brand, class: className } = Astro.props as Props;

let {
  logoPath,
  logoWidth = "320px",
  logoHeight = "80px",
  logoText,
  logoAlternatePath,
  title,
} = brand || {};

if (Astro.props.width) {
  logoWidth = Astro.props.width;
}
if (Astro.props.height) {
  logoHeight = Astro.props.height;
}

const mainLogo = src ? src : logoPath;
const label = title || "Home";
---

<a
  href={getLocaleUrlCTM("/", Astro.currentLocale)}
  aria-label={label}
  class:list={["logo-wrapper py-4 lg:py-7", className]}>
  {
    mainLogo || logoAlternatePath ? (
      <>
        {mainLogo && (
          <OptimizedImage
            src={mainLogo}
            inlineSvg={mainLogo?.endsWith(".svg")}
            class="logo max-sm:h-12! max-sm:w-52!"
            alt={toSentenceCase("Brand logo of " + label)}
            style={{
              height: logoHeight,
              width: logoWidth,
            }}
          />
        )}
        {logoAlternatePath && (
          <OptimizedImage
            src={logoAlternatePath}
            inlineSvg={logoAlternatePath.endsWith(".svg")}
            class="logo-alternate"
            alt={toSentenceCase("Brand logo of " + label)}
            style={{
              height: logoHeight,
              width: logoWidth,
            }}
          />
        )}

        {logoText && (
          <span class="logo-text" set:html={markdownify(logoText)} />
        )}
      </>
    ) : logoText ? (
      logoText
    ) : (
      label
    )
  }
</a>
