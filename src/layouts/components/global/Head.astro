---
import SEO from "@/components/SEO.astro";
import Favicons from "@/components/seo/Favicons.astro";
import BaseSchemas from "@/components/widgets/BaseSchemas.astro";
import { Font } from "astro:assets";
import fontsJson from "@/config/fonts.json";
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";

const fontVariables = fontsJson.map((font) => font.cssVariable) as any[];
const siteGlobals = Astro.props.siteGlobals;

// Resolve canonical URL with fallback to current page URL
const resolvedCanonical = Astro.props.canonical
  ? getLocaleUrlCTM(new URL(Astro.props.canonical, Astro.site).href, Astro.currentLocale)
  : getLocaleUrlCTM(Astro.url.href, Astro.currentLocale);
---

<head>
  <meta charset="UTF-8" />
  <meta http-equiv="Content-Language" content={Astro.currentLocale} />
  {siteGlobals?.brand?.title && <meta name="theme" content={siteGlobals.brand.title} />}
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, maximum-scale=5"
  />
  <SEO {...Astro.props} canonical={resolvedCanonical} />
  <meta name="author" content={Astro.props.author || siteGlobals?.seoDefaults?.author || siteGlobals?.brand?.title} />
  <meta property="og:site_name" content={siteGlobals?.brand?.title} />
  <slot />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: light)"
    content={siteGlobals?.seoDefaults?.themeColorLight || "#ffffff"}
  />
  <meta
    name="theme-color"
    media="(prefers-color-scheme: dark)"
    content={siteGlobals?.seoDefaults?.themeColorDark || "#000000"}
  />
  <meta name="generator" content={Astro.generator} />
  {siteGlobals?.seoDefaults?.headContent && <Fragment set:html={siteGlobals.seoDefaults.headContent} />}
  <Favicons siteGlobals={siteGlobals} />
  <BaseSchemas {...Astro.props} canonical={resolvedCanonical} />

  <!------------------
    Fonts
-------------------->
  {fontVariables.map((font) => <Font cssVariable={font} />)}
</head>
