---
import Icons from "@/helpers/Icons.astro";
import dateFormat from "@/lib/utils/dateFormat";
import { humanize } from "@/lib/utils/textConverter";
import { blogImageUrl, blogPostUrl, type SanityBlogOptions } from "@/lib/sanity/blog";
import type { SanityBlogPost } from "@/lib/sanity/client";
import { useTranslations } from "@/lib/utils/i18nUtils";

interface Props {
  content: SanityBlogPost;
  options?: SanityBlogOptions;
  class?: string;
  tag?: string;
  [key: string]: any;
}
const { content, options = {}, class: className, tag = "h3", ...rest } = Astro.props;
const { layout = "grid" } = options;
const t = await useTranslations(Astro.currentLocale as string);
const href = blogPostUrl(content, Astro.currentLocale);
const image = blogImageUrl(content, layout === "compact" ? 160 : 578, layout === "compact" ? 160 : 248);
const Heading = tag as keyof HTMLElementTagNameMap;
---
{layout === "compact" ? (
  <a href={href} class:list={["group flex items-center gap-4.5 border-text-dark/15 border-b pb-4.5 last:border-0 last:pb-0", className]} {...rest}>
    {image && <img src={image} alt={content.coverImage?.alt || content.title} width="80" height="80" class="size-20 shrink-0 rounded-md object-cover transition-transform group-hover:scale-105" loading="lazy" />}
    <div><span class="text-text-dark/70">{dateFormat(content.publishedAt, "dd MMM, yyyy")}</span><span class="font-secondary line-clamp-2 text-lg font-bold">{content.title}</span></div>
  </a>
) : layout === "horizontal" ? (
  <article class:list={["group border-border-dark/10 relative flex flex-col gap-2 border p-4 lg:p-8", className]} {...rest}>
    <div class="flex items-center gap-2">{content.categories?.map((category) => <span>{humanize(category)}</span>)}<span class="bg-dark mt-1 size-0.5 rounded-full" /><span>{dateFormat(content.publishedAt, "dd MMMM yyyy")}</span></div>
    <div class="grid grid-cols-12 gap-4"><Heading class="sm:text-h5-sm text-h6 col-span-9">{content.title}</Heading><span class="bg-primary text-text-light flex size-12 justify-center items-center"><Icons icon="ArrowUpRight" class="size-6" /></span></div>
    <a data-post-link class="absolute inset-0 z-30" href={href} aria-label={`${t("button.readMore")} ${content.title}`} />
  </article>
) : (
  <article class:list={["group relative border-border-dark/10 flex flex-col gap-4 border p-4 sm:p-6 lg:gap-8 lg:p-9", layout !== "featured" && "rounded-lg text-center", className]} {...rest}>
    <div class:list={["flex flex-col justify-center gap-2 lg:gap-3", layout !== "featured" && "items-center"]}>
      <div class="flex items-center gap-2">{content.categories?.map((category) => <span>{humanize(category)}</span>)}<span class="bg-dark mt-1 size-0.5 rounded-full" /><span>{dateFormat(content.publishedAt, "dd MMMM yyyy")}</span></div>
      <Heading class="sm:text-h4-sm text-h4">{content.title}</Heading>
      {content.excerpt && <p class="text-text-dark/85 leading-6">{content.excerpt}</p>}
    </div>
    {image && <div class:list={["relative flex items-center justify-center overflow-hidden", layout !== "featured" && "rounded-lg"]}><img src={image} alt={content.coverImage?.alt || content.title} width="578" height="248" class="h-62 min-w-full object-cover transition duration-500" loading="lazy" /><span class="bg-accent text-text-dark absolute top-1/2 left-1/2 rounded-full p-4 opacity-0 transition-all group-hover:opacity-100"><Icons icon="ArrowUpRight" class="size-6" /></span></div>}
    <a data-post-link class="absolute inset-0 z-30" href={href} aria-label={`${t("button.readMore")} ${content.title}`} />
  </article>
)}
