---
import { getLocaleUrlCTM, supportedLanguages } from "@/lib/utils/i18nUtils.ts";
import {
  plainify,
  removeWhitespace,
  resolveTaglineSeparator,
} from "@/lib/utils/textConverter";
import config from ".astro/config.generated.json";
import type { SiteGlobals } from "@/lib/sanity/siteGlobals";

export interface SEOProps {
  title?: string;
  metaTitle?: string;
  description?: string;
  metaDescription?: string;
  image?: string;
  canonical?: string;
  keywords?: string[];
  robots?: string;
  disableTagline?: boolean;
  ogType?: string;
  twitter?: string;
  twitterCard?: string;
  ogLocale?: string;
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  imageAlt?: string;
  siteGlobals?: SiteGlobals;
}

const siteGlobals = (Astro.props as SEOProps).siteGlobals;
const seoDefaults = siteGlobals?.seoDefaults;
const {
  title,
  metaTitle,
  description,
  metaDescription,
  image = seoDefaults?.defaultImage || siteGlobals?.brand?.logoPath,
  canonical,
  keywords = seoDefaults?.keywords || [],
  robots = seoDefaults?.robots || "index, follow",
  disableTagline,
  ogType = seoDefaults?.ogType || "website",
  twitter = seoDefaults?.twitter,
  twitterCard = seoDefaults?.twitterCard || "summary_large_image",
  ogLocale = seoDefaults?.ogLocale || "en_US",
  ogTitle,
  ogDescription,
  twitterTitle,
  twitterDescription,
  imageAlt,
} = Astro.props as SEOProps;

// Normalize title and description
let resolvedTitle = plainify(metaTitle ?? title ?? seoDefaults?.title ?? siteGlobals?.brand?.title ?? "");
let resolvedDescription = plainify(
  metaDescription ?? description ?? seoDefaults?.description ?? "",
);

// Add tagline if not disabled
if (!disableTagline && seoDefaults?.tagline) {
  const separator = resolveTaglineSeparator(seoDefaults.taglineSeparator);
  resolvedTitle += separator + seoDefaults.tagline;
}

resolvedTitle = removeWhitespace(resolvedTitle);
resolvedDescription = removeWhitespace(resolvedDescription);

// Canonical URL
const resolvedCanonical = canonical
  ? canonical
  : getLocaleUrlCTM(
      new URL(Astro.url.href, Astro.site).href,
      Astro.currentLocale,
    );

// OG image — make absolute
const ogImage = image?.startsWith("http")
  ? image
  : `${seoDefaults?.baseUrl || Astro.url.origin}${image}`;
const resolvedOgTitle = removeWhitespace(plainify(ogTitle || resolvedTitle));
const resolvedOgDescription = removeWhitespace(
  plainify(ogDescription || resolvedDescription),
);
const resolvedTwitterTitle = removeWhitespace(
  plainify(twitterTitle || resolvedOgTitle),
);
const resolvedTwitterDescription = removeWhitespace(
  plainify(twitterDescription || resolvedOgDescription),
);
const resolvedImageAlt = imageAlt ? removeWhitespace(plainify(imageAlt)) : undefined;

// Alternate language links (i18n routing, not SEO meta)
const alternateTags: Array<{ hreflang: string; href: string }> = [];
if (
  config.settings.multilingual.enable &&
  !resolvedCanonical.includes("blog/category/") &&
  !resolvedCanonical.includes("blog/tag/") &&
  !resolvedCanonical.includes("blog/page/")
) {
  supportedLanguages.forEach((lang) => {
    alternateTags.push({
      hreflang: lang.languageCode,
      href: getLocaleUrlCTM(Astro.url.href, lang.languageCode),
    });
  });
}
---

<title>{resolvedTitle}</title>
<meta name="description" content={resolvedDescription} />
{keywords?.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
<meta name="robots" content={robots} />
{/* favicon <link> tags are emitted by Favicons.astro, which reads seoDefaults.faviconSet */}
<meta property="og:title" content={resolvedOgTitle} />
<meta property="og:description" content={resolvedOgDescription} />
<meta property="og:type" content={ogType || "website"} />
<meta property="og:url" content={resolvedCanonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
{resolvedImageAlt && <meta property="og:image:alt" content={resolvedImageAlt} />}
<meta property="og:locale" content={ogLocale || "en_US"} />
<meta name="twitter:card" content={twitterCard || "summary_large_image"} />
{twitter && <meta name="twitter:site" content={twitter} />}
<meta name="twitter:title" content={resolvedTwitterTitle} />
<meta name="twitter:description" content={resolvedTwitterDescription} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
{resolvedImageAlt && <meta name="twitter:image:alt" content={resolvedImageAlt} />}
{resolvedCanonical && (
  <link rel="canonical" href={resolvedCanonical} itemprop="url" />
)}
{alternateTags.map((tag) => (
  <link rel="alternate" hreflang={tag.hreflang} href={tag.href} />
))}
