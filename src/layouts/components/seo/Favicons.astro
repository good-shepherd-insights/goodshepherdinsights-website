---
import type { SiteGlobals } from "@/lib/sanity/siteGlobals";
import { sanityImageUrl } from "@/lib/sanity/client";

const { siteGlobals } = Astro.props as { siteGlobals?: SiteGlobals };

const faviconSet = siteGlobals?.seoDefaults?.faviconSet ?? [];

const favicons = faviconSet
  .map((item) => {
    const asset = item.image?.image?.asset;
    if (!asset) return null;
    const href = sanityImageUrl(asset).auto("format").url();
    return {
      rel: item.rel,
      type: item.type,
      sizes: item.sizes,
      color: item.color,
      href,
    };
  })
  .filter(
    (entry): entry is {
      rel: string;
      type: string | undefined;
      sizes: string | undefined;
      color: string | undefined;
      href: string;
    } => entry !== null,
  );

const metaTags = [
  { name: "apple-mobile-web-app-title", content: siteGlobals?.brand?.title },
];
---

<!------------------------ Favicons ------------------------>{
  favicons.map((favicon) => (
    <link
      rel={favicon.rel}
      type={favicon.type}
      sizes={favicon.sizes}
      href={favicon.href}
      color={favicon.color}
    />
  ))
}

<link rel="manifest" href="/site.webmanifest" />
{metaTags.map((meta) => <meta name={meta.name} content={meta.content} />)}
