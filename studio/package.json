{
  "name": "good-shepherd-insights",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "start": "sanity start",
    "migrate:blog": "sanity exec scripts/migrate-one-blog.mjs --with-user-token",
    "migrate:blog:dry": "sanity exec scripts/migrate-one-blog.mjs -- --dry-run",
    "migrate:blogs": "sanity exec scripts/migrate-one-blog.mjs --with-user-token -- --all",
    "migrate:blogs:dry": "sanity exec scripts/migrate-one-blog.mjs -- --all --dry-run",
    "migrate:services": "sanity exec scripts/migrate-services.mjs --with-user-token",
    "migrate:services:dry": "sanity exec scripts/migrate-services.mjs -- --dry-run",
    "migrate:site-globals": "sanity exec scripts/migrate-site-globals.mjs --with-user-token",
    "migrate:site-globals:dry": "sanity exec scripts/migrate-site-globals.mjs -- --dry-run"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.7.0",
    "marked": "^18.0.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.7.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
